PORT=10000
MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/dunya?retryWrites=true&w=majority
JWT_SECRET=replace_with_a_long_random_secret
CLIENT_URL=https://YOUR-RENDER-SERVICE.onrender.com

# Cloudinary (required for image/video uploads)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Email OTP (optional until configured)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=DUNYA <no-reply@example.com>

# SMS OTP via Twilio (optional until configured)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Set true only for local testing; OTP will be returned in API response
DEV_RETURN_OTP=false
